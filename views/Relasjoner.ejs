<%- include("./partials/head") %>

<body id="">
    <div class="topicPage">
        <button class="back"><a href="/">Tilbake til skyene</a></button>
        <div class="topicTitleDiv"><h1 class="topicTitle sky">Problemer med venner eller hjemme</h1></div>
        <div class="topicUnderline">
            <div class="line sky"></div>
            <div class="star sky"><p>✦</p></div>
        </div>
          <div class="textBoxes">
            <div class="textBox" class="box1">
              <h1 class="textH1 sky">Hva er det?
</h1>
              <p class="textP">Krangling, drama eller usikkerhet som spiser opp energien din. Du skal ikke stå i vanskelige relasjoner alene.
 </p>

            </div>
            <div class="textBox" class="box2">
              <h1 class="textH1 sky">Symptomer</h1>
              <p class="textP"> Klump i magen før skolen
Konstant krangling hjemme
Følelse av å stå på utsiden
Utrygghet i hverdagen
 </p>
            </div>
            <div class="textBox" class="box3">
              <h1 class="textH1 sky">Løsninger</h1>
              <p class="textP">Snakk med miljøarbeiderne eller helsesykepleier
Få hjelp til å sette egne grenser
Lær å navigere i vanskelige konflikter
Bruk elevtjenesten som har taushetsplikt</p>
          </div>
        </div>
      <video autoplay loop muted playsinline>
        <source src="/img/sky.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>

        <%- include("./partials/footer") %>
        
</body>


</html>